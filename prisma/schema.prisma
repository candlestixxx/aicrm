generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Authentication ────────────────────────────────────────────








// ─── Multi-Tenant Hierarchy ────────────────────────────────────






// ─── Contacts & Leads ──────────────────────────────────────────




// ─── Pipeline ──────────────────────────────────────────────────




// ─── Properties (MLS-compliant) ────────────────────────────────






// ─── Activities & Tasks ────────────────────────────────────────






// ─── Marketing Campaigns ───────────────────────────────────────




// ─── Social Media OAuth ────────────────────────────────────────


// ─── API Key Vault ─────────────────────────────────────────────




// ----------------------------------------------------------------------------
// Phase 2: Security Vault
// ----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("agent") // agent | admin | brokerage_admin
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agentProfile Agent?
  accounts     Account[]
  sessions     Session[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  sessionState      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brokerages Brokerage[]
  contacts   Contact[]
  tags       Tag[]
}

model Brokerage {
  slug      String   @unique
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  website   String?
  mlsId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agents    AgentProfile[]
  teams             Team[]
  pipelines         Pipeline[]
  properties        Property[]
  listingStatusLogs ListingStatusLog[]
  secrets           Secret[]
  approvalQueues    ApprovalQueue[]
  agentAuditLogs    AgentAuditLog[]
  brokerAgents      Agent[]
  vectorEmbeddings  VectorEmbedding[]
}

model Team {
  id          String   @id @default(uuid())
  name        String
  brokerageId String
  leadAgentId String?  @unique // Team lead (one agent leads one team)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brokerage Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  leadAgent Agent?    @relation("TeamLead", fields: [leadAgentId], references: [id])
  agents    Agent[]   @relation("TeamMembers")
}

model Agent {
  id              String   @id @default(uuid())
  userId          String   @unique
  brokerageId     String
  teamId          String?
  licenseNumber   String?
  mlsAgentId      String?
  title           String?
  phone           String?
  bio             String?
  commissionSplit Float?   @default(70.0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerage        Brokerage       @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  team             Team?           @relation("TeamMembers", fields: [teamId], references: [id])
  ledTeam          Team?           @relation("TeamLead")
  managedContacts Contact[] @relation("AgentManagedContacts")
  tasks            Task[]
  listedProperties Property[]
  socialAccounts   SocialAccount[]
  approvalQueues   ApprovalQueue[]
  auditLogs        AgentAuditLog[]
  segments         Segment[]
}

model AgentProfile {
  id          String   @id @default(uuid())
  brokerageId String
  userId      String   @unique // Link to an external auth provider ID in the future
  firstName   String
  lastName    String
  email       String   @unique
  phone       String?
  licenseNo   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brokerage   Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  contacts    Contact[] // Contacts assigned to this specific agent
}

model Contact {
  id           String   @id @default(uuid())
  tenantId     String
  agentId      String?
  firstName    String
  lastName     String?
  email        String?
  phone        String?
  stage        String   @default("New Lead") // e.g. New Lead, Hot, Nurturing, Closed
  source       String?
  enrichedData Json?    // Stores data from the background web-scrubber
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent        AgentProfile? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  tags         ContactTag[]
  mlsData      MlsData?
  leads          Lead[]
  properties     Property[]
  tasks          Task[] @relation("TaskContact")
  activities     Activity[]
  communications Communication[]
  managerAgentId String?
  managerAgent   Agent?   @relation("AgentManagedContacts", fields: [managerAgentId], references: [id], onDelete: SetNull)
}

model Tag {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  color     String?
  createdAt DateTime @default(now())

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts  ContactTag[]

  @@unique([tenantId, name])
}

model ContactTag {
  contactId String
  tagId     String

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model MlsData {
  id             String   @id @default(uuid())
  contactId      String   @unique
  mlsNumber      String?
  propertyType   String?
  searchCriteria Json?
  lastActive     DateTime?

  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model Lead {
  id            String    @id @default(uuid())
  contactId     String    @unique
  pipelineId    String?
  stageId       String?
  status        String    @default("new") // new | active | hot | cold | closed_won | closed_lost
  score         Int       @default(0)
  budgetMin     Float?
  budgetMax     Float?
  propertyType  String? // single_family, condo, multi_family, land, commercial
  timeline      String? // immediate, 1-3mo, 3-6mo, 6-12mo, 12mo+
  preApproved   Boolean   @default(false)
  lastContacted DateTime?
  nextFollowUp  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contact               Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  pipeline              Pipeline?              @relation(fields: [pipelineId], references: [id])
  stage                 PipelineStage?         @relation(fields: [stageId], references: [id])
  campaignExecutionLogs CampaignExecutionLog[]
}

model Pipeline {
  id          String   @id @default(uuid())
  name        String
  brokerageId String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brokerage Brokerage       @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]
  leads     Lead[]
}

model PipelineStage {
  id         String   @id @default(uuid())
  pipelineId String
  name       String // New Lead, Contacted, Showing Scheduled, Offer Made, Negotiation, Closed
  order      Int
  color      String? // hex color for kanban
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]
}

model Property {
  id             String    @id @default(uuid())
  brokerageId    String
  mlsNumber      String?   @unique
  address        String
  city           String
  state          String
  zip            String
  propertyType   String // single_family, condo, multi_family, land, commercial
  listPrice      Float?
  bedrooms       Int?
  bathrooms      Float?
  squareFeet     Int?
  lotSize        Float?
  yearBuilt      Int?
  description    String?
  status         String    @default("active") // active | pending | sold | off_market | expired | canceled | unconditional_withdraw | conditional_withdraw
  mlsStatus      String? // raw status as delivered by the MLS/provider
  mlsProvider    String? // which MLS this listing belongs to (realcomp, mimls, ...)
  source         String? // manual | import | webhook | realcomp | other provider
  lastSyncedAt   DateTime?
  contactId      String? // optional link to the contact/lead for this address
  listedDate     DateTime?
  soldDate       DateTime?
  soldPrice      Float?
  listingAgentId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  brokerage    Brokerage          @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  listingAgent Agent?             @relation(fields: [listingAgentId], references: [id])
  contact      Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  images       PropertyImage[]
  statusLogs   ListingStatusLog[]
}

model ListingStatusLog {
  id             String   @id @default(uuid())
  brokerageId    String
  propertyId     String?
  mlsNumber      String?
  address        String?
  previousStatus String?
  newStatus      String
  source         String // manual | import | webhook | provider | sync
  rawPayload     String? // JSON of the raw provider/webhook payload
  createdAt      DateTime @default(now())

  brokerage Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  property  Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([mlsNumber])
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  url        String
  caption    String?
  isPrimary  Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(uuid())
  agentId     String
  contactId   String?
  title       String
  description String?
  dueDate     DateTime?
  priority    String    @default("medium") // low | medium | high | urgent
  status      String    @default("pending") // pending | in_progress | completed | cancelled
  type        String    @default("call") // call | email | meeting | showing | follow_up | other
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agent   Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  contact Contact? @relation("TaskContact", fields: [contactId], references: [id])
}

model Activity {
  id          String   @id @default(uuid())
  contactId   String
  type        String // note, call, email, sms, meeting, showing, status_change
  description String
  metadata    String? // JSON for extra context
  createdAt   DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model Communication {
  id          String    @id @default(uuid())
  contactId   String
  direction   String    @default("outbound") // inbound | outbound
  channel     String // sms | email | voice
  subject     String?
  body        String
  status      String    @default("sent") // queued | sent | delivered | failed | received
  metadata    String? // JSON: delivery status, provider message ID, etc.
  sentAt      DateTime  @default(now())
  deliveredAt DateTime?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model Secret {
  id          String   @id @default(uuid())
  brokerageId String
  category    String
  label       String
  value       String
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brokerage Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)

  @@index([brokerageId, category])
}

model ApiKey {
  id        String   @id @default(uuid())
  provider  String   @unique
  key       String // AES-256-GCM encrypted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workflow {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  triggers    WorkflowTrigger[]
  actions     WorkflowAction[]
}

model WorkflowTrigger {
  id         String   @id @default(uuid())
  workflowId String
  type       String   // e.g., 'TAG_ADDED', 'INCOMING_SMS', 'FORM_SUBMITTED'
  config     Json?    // Optional configuration, e.g., { "tagName": "Hot Lead" }
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model WorkflowAction {
  id         String   @id @default(uuid())
  workflowId String
  type       String   // e.g., 'UPDATE_STAGE', 'SEND_EMAIL', 'START_CAMPAIGN'
  config     Json?    // Optional configuration, e.g., { "stage": "Nurturing" }
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model Campaign {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  status      String   @default("DRAFT") // DRAFT, ACTIVE, PAUSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       CampaignStep[]
  executionLogs CampaignExecutionLog[]
}

model CampaignStep {
  id          String   @id @default(uuid())
  campaignId  String
  type        String   // EMAIL, SMS, TASK
  content     String?  // Template string or instruction for AI
  delayHours  Int      @default(0) // Delay from previous step
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  executionLogs CampaignExecutionLog[]
}

model CampaignExecutionLog {
  id             String    @id @default(uuid())
  campaignId     String
  campaignStepId String
  leadId         String
  status         String    @default("queued") // queued | processing | completed | failed
  error          String?
  executedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignStep CampaignStep @relation(fields: [campaignStepId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Funnel {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  domain      String?  @unique // Custom domain for the funnel
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pages       LandingPage[]
}

model LandingPage {
  id          String   @id @default(uuid())
  funnelId    String
  name        String
  slug        String   // e.g., /home, /opt-in
  content     Json?    // Serialized layout data (e.g., from a block builder)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  funnel      Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id           String   @id @default(uuid())
  tenantId     String
  platform     String   // e.g., 'FACEBOOK', 'LINKEDIN', 'INSTAGRAM'
  accessToken  String   // In reality, this should be encrypted
  refreshToken String?
  profileName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agentId      String?
  agent        Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  posts        SocialPost[]
}

model SocialPost {
  id            String   @id @default(uuid())
  socialAccountId String
  content       String
  scheduledAt   DateTime?
  publishedAt   DateTime?
  status        String   @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED, FAILED
  platformPostId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
}

model Segment {
  id        String   @id @default(uuid())
  agentId   String
  name      String
  criteria  Json?    // Filter criteria for contact segmentation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model ApprovalQueue {
  id          String   @id @default(uuid())
  brokerageId String
  agentId     String
  actionType  String // draft_email, update_contract, send_sms, post_social
  payload     String // JSON payload of the proposed action
  status      String   @default("pending") // pending | approved | rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brokerage Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model AgentAuditLog {
  id          String   @id @default(uuid())
  brokerageId String
  agentId     String
  taskId      String?
  action      String
  reasoning   String // Chain of thought
  metadata    String? // JSON
  createdAt   DateTime @default(now())

  brokerage Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model VectorEmbedding {
  id          String   @id @default(uuid())
  brokerageId String
  sourceType  String // email, note, property
  sourceId    String
  content     String
  embedding   String // JSON array of floats (fallback for SQLite, real implementation would use pgvector)
  createdAt   DateTime @default(now())

  brokerage Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
}

