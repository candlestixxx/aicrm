# ─── Database ────────────────────────────────────────────────
# SQLite (development)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production) — when ready to switch:
# DATABASE_URL="postgresql://user:password@host:5432/aicrm?schema=public"

# ─── Security ────────────────────────────────────────────────
# Encryption secret for the API key vault (min 32 chars)
# Generate with: openssl rand -base64 48
ENCRYPTION_SECRET="change-me-to-a-strong-random-secret-32-chars"

# JWT secret for session tokens (min 32 chars)
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-strong-random-jwt-secret-32chars"

# Token for external MCP agents to call the HyperNexus MCP endpoint
# (POST /api/mcp with header: Authorization: Bearer <this-token>)
# Generate with: openssl rand -hex 32
MCP_TOKEN="change-me-to-a-random-mcp-token"

# HyperNexus control plane kernel (https://github.com/HyperNexusllc/HyperNexus)
# Used for shared persistent memory + agent chat routing
HYPERNEXUS_URL="http://127.0.0.1:7778"

# AI engine: native (direct vault keys) | controlplane (HyperNexus) | hybrid
AI_ENGINE="native"

# ─── MLS listing status sync (multiple providers supported) ─────
# Comma-separated list of provider ids. Each id reads its own env block:
#   MLS_<ID>_NAME, MLS_<ID>_API_URL, MLS_<ID>_USERNAME,
#   MLS_<ID>_PASSWORD, MLS_<ID>_LOOKUP_PATH (path with {mls} placeholder)
MLS_PROVIDERS="realcomp,mimls"

# Realcomp
# MLS_REALCOMP_NAME="Realcomp"
# MLS_REALCOMP_API_URL="https://api.realcomp.example.com"
# MLS_REALCOMP_USERNAME=""
# MLS_REALCOMP_PASSWORD=""
# MLS_REALCOMP_LOOKUP_PATH="/listings/{mls}"

# MiMLS (Paragon). IMPORTANT: use the RETS/Web API endpoint from MiMLS
# tech support — NOT the web login page (…/ParagonLS/Default.mvc/Login).
# MLS_MIMLS_NAME="MiMLS"
# MLS_MIMLS_API_URL="https://mimls.rets.paragonrels.com"
# MLS_MIMLS_USERNAME=""
# MLS_MIMLS_PASSWORD=""
# MLS_MIMLS_LOOKUP_PATH="/rets/search?{mls}"

# Secret your MLS provider sends in the x-mls-secret header when POSTing
# status changes to /api/webhooks/mls (leave unset in dev to accept all)
# Generate with: openssl rand -hex 32
# MLS_WEBHOOK_SECRET="change-me"

# ─── Application ─────────────────────────────────────────────
# Base URL used in emails and OAuth redirects
# AiCRM runs on port 3001 (port 3000 is reserved for the original CRM)
APP_URL="http://localhost:3001"

# ─── Email ───────────────────────────────────────────────────
# console (dev) | smtp | resend | sendgrid
EMAIL_PROVIDER="console"

# SMTP (when EMAIL_PROVIDER=smtp)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# ─── Social OAuth (optional) ─────────────────────────────────
# Facebook (Meta for Developers)
# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""

# Instagram (Meta Graph API)
# INSTAGRAM_CLIENT_ID=""
# INSTAGRAM_CLIENT_SECRET=""

# LinkedIn
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""

# YouTube (Google Cloud Console)
# YOUTUBE_CLIENT_ID=""
# YOUTUBE_CLIENT_SECRET=""

# Google Business Profile
# GOOGLE_BUSINESS_CLIENT_ID=""
# GOOGLE_BUSINESS_CLIENT_SECRET=""
